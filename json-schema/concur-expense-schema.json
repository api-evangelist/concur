{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Expense",
  "title": "Expense",
  "type": "object",
  "description": "An individual expense entry.",
  "properties": {
    "expenseId": {
      "type": "string",
      "description": "Unique identifier for the expense entry.",
      "example": "600456"
    },
    "expenseTypeName": {
      "type": "string",
      "description": "Name of the expense type.",
      "example": "Airfare"
    },
    "transactionDate": {
      "type": "string",
      "format": "date",
      "description": "Date of the transaction.",
      "example": "2026-03-10"
    },
    "transactionAmount": {
      "type": "number",
      "format": "double",
      "description": "Amount of the transaction.",
      "example": 875.5
    },
    "transactionCurrencyCode": {
      "type": "string",
      "description": "Currency code of the transaction.",
      "example": "USD"
    },
    "vendorName": {
      "type": "string",
      "description": "Name of the vendor.",
      "example": "United Airlines"
    },
    "description": {
      "type": "string",
      "description": "Description of the expense.",
      "example": "Flight from SFO to JFK"
    },
    "receiptRequired": {
      "type": "boolean",
      "description": "Whether a receipt is required.",
      "example": true
    }
  }
}